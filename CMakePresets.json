{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "debug",
            "displayName": "debug",
            "description": "debug configuration using Ninja",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_COMPILE_WARNING_AS_ERROR": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "ENABLE_CLANG_FORMAT": "ON",
                "ENABLE_CLANG_TIDY": "ON",
                "SHOWCASEGL_BUILD_EXAMPLES": "ON",
                "SHOWCASEGL_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "release",
            "displayName": "release",
            "description": "release configuration using Ninja",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "ENABLE_CLANG_FORMAT": "OFF",
                "ENABLE_CLANG_TIDY": "OFF",
                "SHOWCASEGL_BUILD_EXAMPLES": "OFF",
                "SHOWCASEGL_BUILD_TESTS": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release",
            "targets": [
                "showcasegl"
            ]
        }
    ],
    "testPresets": [
        {
            "name": "debug",
            "configurePreset": "debug",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        }
    ]
}